# Settings for the backend (see README.md). Set them in your hosting panel or export them before running.
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=put-a-long-random-text-here-at-least-32-characters
# ADDR=:8080                 # or PORT=8080
# DB_PATH=data/tablebill.db  # put on a persistent disk in production
# TRUST_PROXY=1              # when behind the frontend / a reverse proxy
# DEMO=0                     # 1 enables one-click demo logins - never in production
# RESTAURANT_NAME=My Restaurant
# CURRENCY=₹
